# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SEO (canonical URL of the site, sin trailing slash)
# - dev: http://localhost:3000
# - vercel provisional: https://warszawski.vercel.app
# - producción: https://warszawski.com
NEXT_PUBLIC_SITE_URL=https://warszawski.com.ar

# Brand contact (hardcoded en frontend via lib/site-config.ts)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google tracking (GA4 + Google Ads). Vacíos = no se cargan scripts de Google.
# - GA4 measurement ID  → Google Analytics > Admin > Data streams (formato G-XXXXXXX)
# - Google Ads ID       → Google Ads > Goals > Conversions > el tag (formato AW-XXXXXXXXX)
# - Conversion label     → el label de la conversión "lead de WhatsApp":
#                          en send_to `AW-XXXXXXXXX/AbC-D_efGhIj`, es `AbC-D_efGhIj`.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=

# Reportes: token secreto del link privado /r/<token> que se comparte con el
# cliente. Elegí un valor largo y difícil de adivinar (ej. uuid). Server-only.
REPORTS_TOKEN=
