# From `dbm env warszawski`
DATABASE_URL=postgresql://warszawski_app:<pw>@db.example.com:6432/warszawski?sslmode=verify-full
DATABASE_URL_SESSION=postgresql://warszawski_app:<pw>@db.example.com:6432/warszawski_session?sslmode=verify-full
S3_ENDPOINT=https://s3.example.com
S3_REGION=garage
S3_BUCKET=warszawski
S3_ACCESS_KEY_ID=GK...
S3_SECRET_ACCESS_KEY=...
# Public base URL of the bucket (`dbm storage public warszawski`); product images are served from here.
S3_PUBLIC_BASE_URL=https://warszawski.web.example.com
BETTER_AUTH_SECRET=<32 random bytes>
# Production: your app URL. Preview: leave unset (exact VERCEL_URL is used). Local dev: unset falls back to http://localhost:3000.
BETTER_AUTH_URL=https://warszawski.com.ar
# Only with `dbm init --tls self-ca`
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...

# SEO (canonical URL of the site, sin trailing slash)
# - dev: http://localhost:3000
# - vercel provisional: https://warszawski.vercel.app
# - producción: https://warszawski.com
NEXT_PUBLIC_SITE_URL=https://warszawski.com.ar

# Brand contact (hardcoded en frontend via lib/site-config.ts)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google tracking (GA4 + Google Ads). Vacíos = no se cargan scripts de Google.
# - GA4 measurement ID  → Google Analytics > Admin > Data streams (formato G-XXXXXXX)
# - Google Ads ID       → Google Ads > Goals > Conversions > el tag (formato AW-XXXXXXXXX)
# - Conversion label     → el label de la conversión "lead de WhatsApp":
#                          en send_to `AW-XXXXXXXXX/AbC-D_efGhIj`, es `AbC-D_efGhIj`.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=

# Reportes: token secreto del link privado /r/<token> que se comparte con el
# cliente. Elegí un valor largo y difícil de adivinar (ej. uuid). Server-only.
REPORTS_TOKEN=
